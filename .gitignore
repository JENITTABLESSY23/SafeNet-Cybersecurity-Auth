# The raw CICIoT2023 CSVs are hundreds of MB to multiple GB — GitHub isn't
# built for that, and the deployed app doesn't need them anyway (only the
# already-trained files in ml/outputs/*.pkl are used at runtime). Keep the
# placeholder note so the folder itself still exists in git.
ml/CICIoT2023/*.csv
!ml/CICIoT2023/DOWNLOAD_DATASET_HERE.txt

# Java build output — regenerated by the Docker build on every deploy.
backend/target/

# Empty stray file some earlier run created at the repo root; the real
# database Docker actually uses is backend/safenet.db (kept, see Dockerfile).
/safenet.db

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
*.pyc
__pycache__/
